<idea-plugin>
    <id>com.yanny.archflow</id>
    <name>Archflow</name>
    <vendor>Yanny</vendor>
    <description>Shows the architecture of a Java codebase as one graph with levels, and how it changed between commits.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Archflow" anchor="bottom" icon="AllIcons.Toolwindows.ToolWindowHierarchy"
                    factoryClass="com.yanny.archflow.plugin.ArchflowToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="Archflow.ShowInArchflow" class="com.yanny.archflow.plugin.ShowInArchflowAction" text="Show in Archflow"
                description="Selects in the Archflow graph what the caret is on: an edge whose place is this line, or the innermost node">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
